{
  "name": "dsh-context-meter",
  "version": "0.2.0",
  "type": "module",
  "description": "Context-occupancy ring in the DeepSeek Harness composer tool row, moved out of the dock row below the card.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "context",
    "composer",
    "token"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunxiao11xie/dsh-context-meter.git"
  },
  "homepage": "https://github.com/yunxiao11xie/dsh-context-meter#readme",
  "engines": {
    "dsh": ">=0.2.0-rc.1 || >=0.2.1-rc.1 || >=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
